دالة(ازاحة_الركن, نصف_ق, صف)
    اذا(نصف_ق = 6)
        اذا(صف = 0)
            ارجع(4)
        نهاية_الشرط
        اذا(صف = 1)
            ارجع(2)
        نهاية_الشرط
        اذا(صف = 2)
            ارجع(1)
        نهاية_الشرط
        اذا(صف = 3)
            ارجع(1)
        نهاية_الشرط
    نهاية_الشرط
    اذا(نصف_ق = 4)
        اذا(صف = 0)
            ارجع(2)
        نهاية_الشرط
        اذا(صف = 1)
            ارجع(1)
        نهاية_الشرط
    نهاية_الشرط
    ارجع(0)
نهاية(ازاحة_الركن)

دالة(ارسم_مستطيل_مدور, س, ص, عرض, ارتفاع, لون, نصف_ق)
    صحيح صف = 0
    حلقة()
        اذا(صف = ارتفاع)
            كسر()
        نهاية_الشرط
        صحيح زاوية = 0
        اذا(صف < نصف_ق)
            زاوية = ازاحة_الركن(نصف_ق, صف)
        نهاية_الشرط
        اذا(صف >= ارتفاع - نصف_ق)
            زاوية = ازاحة_الركن(نصف_ق, ارتفاع - 1 - صف)
        نهاية_الشرط
        صحيح عرض_صف = عرض - زاوية * 2
        اذا(عرض_صف > 0)
            ذاكرة_املأ32(مشهد + (ص + صف) * ل + (س + زاوية) * 4, لون, عرض_صف)
        نهاية_الشرط
        صف = صف + 1
    نهاية_الحلقة
نهاية(ارسم_مستطيل_مدور)

دالة(ارسم_نافذة, رقم_النافذة)
    مؤشر سج = جدول_النوافذ + رقم_النافذة * حجم_السجل
    صحيح ق_س = ذاكرة_اقرا32(سج + سجل_س)
    صحيح ق_ص = ذاكرة_اقرا32(سج + سجل_ص)
    صحيح ق_ع = ذاكرة_اقرا32(سج + سجل_ع)
    صحيح ق_ا = ذاكرة_اقرا32(سج + سجل_ا)
    صحيح ق_لون = ذاكرة_اقرا32(سج + سجل_لون)
    صحيح سطح_ع = ذاكرة_اقرا32(سج + سجل_سطح_ع)
    صحيح سطح_ا = ذاكرة_اقرا32(سج + سجل_سطح_ا)
    مؤشر سطح_العميل = ذاكرة_اقرا64(سج + سجل_سطح_مؤشر)
    صحيح لون_حد = لون_حد_خامل
    اذا(رقم_النافذة = نافذة_نشطة)
        لون_حد = ق_لون
    نهاية_الشرط
    اذا(رقم_النافذة = هدف_تبديل)
        لون_حد = لون_هدف
    نهاية_الشرط
    ارسم_مستطيل_مدور(ق_س, ق_ص, ق_ع, ق_ا, لون_حد, 6)
    اذا(سطح_العميل > 0)
        مؤشر وجهة = مشهد + (ق_ص + سمك_الحد) * ل + (ق_س + سمك_الحد) * 4
        صحيح ر_م = 0
        حلقة()
            اذا(ر_م = سطح_ا)
                كسر()
            نهاية_الشرط
            صحيح زاوية = 0
            اذا(ر_م < 4)
                زاوية = ازاحة_الركن(4, ر_م)
            نهاية_الشرط
            اذا(ر_م >= سطح_ا - 4)
                زاوية = ازاحة_الركن(4, سطح_ا - 1 - ر_م)
            نهاية_الشرط
            صحيح طول_نسخ = (سطح_ع - زاوية * 2) * 4
            اذا(طول_نسخ > 0)
                ذاكرة_انسخ(وجهة + ر_م * ل + زاوية * 4, سطح_العميل + (ر_م * سطح_ع + زاوية) * 4, طول_نسخ)
            نهاية_الشرط
            ر_م = ر_م + 1
        نهاية_الحلقة
    نهاية_الشرط
    اذا(رقم_النافذة = نافذة_نشطة)
        اذا(سحب_ن < 0)
            اذا(ق_ع > 60)
                صحيح زر_اغلاق_س = ق_س + ق_ع - سمك_الحد - ازاحة_زر
                صحيح زر_اغلاق_ص = ق_ص + سمك_الحد + هامش_زر
                ارسم_مستطيل_مدور(زر_اغلاق_س, زر_اغلاق_ص, حجم_زر, حجم_زر, لون_الاغلاق, 6)
            نهاية_الشرط
        نهاية_الشرط
    نهاية_الشرط
نهاية(ارسم_نافذة)
