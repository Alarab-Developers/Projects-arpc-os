تضمين(".\المصدر\لوحة_الرسم_الرقمية\مخزن_الاطارات.لغة")

مؤشر إطار_هدف = 0
صحيح س_هدف = 0
صحيح ص_هدف = 0
صحيح عرض_هدف = 0
صحيح ارتفاع_هدف = 0
صحيح لون_هدف = 0

صحيح س = 0
صحيح ص = 0
صحيح عرض = 0
صحيح ارتفاع = 0
صحيح لون = 0

صحيح س1 = 0
صحيح ص1 = 0
صحيح س2 = 0
صحيح ص2 = 0

صحيح س_مركز = 0
صحيح ص_مركز = 0
صحيح نصف_قطر = 0

دالة(املأ_مستطيل_في)
    ذاكرة_املأ32(إطار_هدف + ص_هدف * ل + س_هدف * 4, لون_هدف, عرض_هدف)
    صحيح صف = 1
    حلقة()
        اذا(صف = ارتفاع_هدف)
            كسر()
        نهاية_الشرط
        ذاكرة_املأ32(إطار_هدف + (ص_هدف + صف) * ل + س_هدف * 4, لون_هدف, عرض_هدف)
        صف = صف + 1
    نهاية_الحلقة
نهاية(املأ_مستطيل_في)

دالة(املأ_مستطيل)
    إطار_هدف = مشهد
    س_هدف = س
    ص_هدف = ص
    عرض_هدف = عرض
    ارتفاع_هدف = ارتفاع
    لون_هدف = لون
    املأ_مستطيل_في()
نهاية(املأ_مستطيل)

دالة(ارسم_خط_أفقي)
    اذا(س1 > س2)
        صحيح مؤقت = س1
        س1 = س2
        س2 = مؤقت
    نهاية_الشرط
    ذاكرة_املأ32(مشهد + ص * ل + س1 * 4, لون, س2 - س1 + 1)
نهاية(ارسم_خط_أفقي)

دالة(ارسم_خط_عمودي)
    اذا(ص1 > ص2)
        صحيح مؤقت = ص1
        ص1 = ص2
        ص2 = مؤقت
    نهاية_الشرط
    صحيح صف = ص1
    حلقة()
        اذا(صف > ص2)
            كسر()
        نهاية_الشرط
        ذاكرة_اكتب32(مشهد + صف * ل + س * 4, لون)
        صف = صف + 1
    نهاية_الحلقة
نهاية(ارسم_خط_عمودي)

دالة(ارسم_إطار)
    ارسم_خط_أفقي(س, س + عرض - 1, ص, لون)
    ارسم_خط_أفقي(س, س + عرض - 1, ص + ارتفاع - 1, لون)
    ارسم_خط_عمودي(س, ص, ص + ارتفاع - 1, لون)
    ارسم_خط_عمودي(س + عرض - 1, ص, ص + ارتفاع - 1, لون)
نهاية(ارسم_إطار)

دالة(ارسم_خط)
    صحيح ف_س = س1
    صحيح ف_ص = ص1
    صحيح د_س = س2 - س1
    اذا(د_س < 0)
        د_س = -د_س
    نهاية_الشرط
    صحيح د_ص = ص2 - ص1
    اذا(د_ص < 0)
        د_ص = -د_ص
    نهاية_الشرط
    صحيح خ_س = 1
    اذا(س1 > س2)
        خ_س = -1
    نهاية_الشرط
    صحيح خ_ص = 1
    اذا(ص1 > ص2)
        خ_ص = -1
    نهاية_الشرط
    صحيح خطأ = د_س - د_ص
    حلقة()
        ذاكرة_اكتب32(مشهد + ف_ص * ل + ف_س * 4, لون)
        اذا(ف_س = س2)
            اذا(ف_ص = ص2)
                كسر()
            نهاية_الشرط
        نهاية_الشرط
        صحيح خطأ2 = خطأ * 2
        اذا(خطأ2 > -د_ص)
            خطأ = خطأ - د_ص
            ف_س = ف_س + خ_س
        نهاية_الشرط
        اذا(خطأ2 < د_س)
            خطأ = خطأ + د_س
            ف_ص = ف_ص + خ_ص
        نهاية_الشرط
    نهاية_الحلقة
نهاية(ارسم_خط)

دالة(املأ_دائرة)
    صحيح ف_ص = -نصف_قطر
    حلقة()
        اذا(ف_ص > نصف_قطر)
            كسر()
        نهاية_الشرط
        صحيح ف_س = -نصف_قطر
        حلقة()
            اذا(ف_س > نصف_قطر)
                كسر()
            نهاية_الشرط
            اذا(ف_س * ف_س + ف_ص * ف_ص <= نصف_قطر * نصف_قطر)
                ذاكرة_اكتب32(مشهد + (ص_مركز + ف_ص) * ل + (س_مركز + ف_س) * 4, لون)
            نهاية_الشرط
            ف_س = ف_س + 1
        نهاية_الحلقة
        ف_ص = ف_ص + 1
    نهاية_الحلقة
نهاية(املأ_دائرة)

دالة(ارسم_دائرة)
    صحيح ف_ص = -نصف_قطر
    حلقة()
        اذا(ف_ص > نصف_قطر)
            كسر()
        نهاية_الشرط
        صحيح ف_س = -نصف_قطر
        حلقة()
            اذا(ف_س > نصف_قطر)
                كسر()
            نهاية_الشرط
            صحيح د2 = ف_س * ف_س + ف_ص * ف_ص
            اذا(د2 <= نصف_قطر * نصف_قطر)
                اذا(د2 >= (نصف_قطر - 1) * (نصف_قطر - 1))
                    ذاكرة_اكتب32(مشهد + (ص_مركز + ف_ص) * ل + (س_مركز + ف_س) * 4, لون)
                نهاية_الشرط
            نهاية_الشرط
            ف_س = ف_س + 1
        نهاية_الحلقة
        ف_ص = ف_ص + 1
    نهاية_الحلقة
نهاية(ارسم_دائرة)

دالة(املأ_مستطيل_على, مؤشر_الإطار, س_ج, ص_ج, عرض_ج, ارتفاع_ج, لون_ج)
    إطار_هدف = مؤشر_الإطار
    س_هدف = س_ج
    ص_هدف = ص_ج
    عرض_هدف = عرض_ج
    ارتفاع_هدف = ارتفاع_ج
    لون_هدف = لون_ج
    املأ_مستطيل_في()
نهاية(املأ_مستطيل_على)

دالة(املأ_مثلث_قائم_على, مؤشر_الإطار, س_ج, ص_ج, ارتفاع_ج, لون_ج)
    صحيح صف = 0
    حلقة()
        اذا(صف = ارتفاع_ج)
            كسر()
        نهاية_الشرط
        ذاكرة_املأ32(مؤشر_الإطار + (ص_ج + صف) * ل + س_ج * 4, لون_ج, صف + 1)
        صف = صف + 1
    نهاية_الحلقة
نهاية(املأ_مثلث_قائم_على)
