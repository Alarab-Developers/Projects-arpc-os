تضمين(".\المصدر\الخلفية.لغة")
تضمين(".\المصدر\سهم_المؤشر.لغة")
تضمين(".\المصدر\تعريفات.لغة")
تضمين(".\المصدر\نافذة.لغة")
تضمين(".\المصدر\شريط_القوائم.لغة")

دالة(اختر_لون)
    صحيح لون = 0x0089B4FA
    اذا(رقم_لون = 1)
        لون = 0x00A6E3A1
    نهاية_الشرط
    اذا(رقم_لون = 2)
        لون = 0x00F9E2AF
    نهاية_الشرط
    اذا(رقم_لون = 3)
        لون = 0x00CBA6F7
    نهاية_الشرط
    اذا(رقم_لون = 4)
        لون = 0x0094E2D5
    نهاية_الشرط
    اذا(رقم_لون = 5)
        لون = 0x00FAB387
    نهاية_الشرط
    رقم_لون = رقم_لون + 1
    اذا(رقم_لون > 5)
        رقم_لون = 0
    نهاية_الشرط
    ارجع(لون)
نهاية(اختر_لون)

دالة(جهز_سطح, مؤشر_السجل, عرض_سطح, ارتفاع_سطح)
    صحيح سطح_ع_قديم = ذاكرة_اقرا32(مؤشر_السجل + سجل_سطح_ع)
    صحيح سطح_ا_قديم = ذاكرة_اقرا32(مؤشر_السجل + سجل_سطح_ا)
    اذا(سطح_ع_قديم = عرض_سطح)
        اذا(سطح_ا_قديم = ارتفاع_سطح)
            ارجع()
        نهاية_الشرط
    نهاية_الشرط

    مؤشر سطح_العميل = ذاكرة_اقرا64(مؤشر_السجل + سجل_سطح_مؤشر)
    اذا(سطح_العميل > 0)
        ذاكرة_حرر(سطح_العميل)
    نهاية_الشرط
    سطح_العميل = 0

    اذا(عرض_سطح > 0)
        اذا(ارتفاع_سطح > 0)
            سطح_العميل = ذاكرة_خصص(عرض_سطح * ارتفاع_سطح * 4)
        نهاية_الشرط
    نهاية_الشرط

    اذا(سطح_العميل = 0)
        ذاكرة_اكتب32(مؤشر_السجل + سجل_سطح_ع, 0)
        ذاكرة_اكتب32(مؤشر_السجل + سجل_سطح_ا, 0)
        ذاكرة_اكتب64(مؤشر_السجل + سجل_سطح_مؤشر, 0)
        ارجع()
    نهاية_الشرط

    ذاكرة_املأ32(سطح_العميل, لون_المحتوى, عرض_سطح * ارتفاع_سطح)

    اذا(عرض_سطح > 64)
        صحيح ر_ز = 14
        صحيح حد_ا = ارتفاع_سطح - 8
        صحيح رقم_سطر = 0
        صحيح نمط_سطر = 0
        حلقة()
            صحيح ن_ح = ر_ز + 4
            اذا(ن_ح > حد_ا)
                كسر()
            نهاية_الشرط
            صحيح عرض_سطر = عرض_سطح - 32
            صحيح لون_هذا = لون_سطر
            اذا(رقم_سطر = 0)
                عرض_سطر = عرض_سطر / 3
                لون_هذا = ذاكرة_اقرا32(مؤشر_السجل + سجل_لون)
            والا
                اذا(نمط_سطر = 1)
                    عرض_سطر = عرض_سطر * 2 / 3
                    نمط_سطر = 0
                والا
                    نمط_سطر = 1
                نهاية_الشرط
            نهاية_الشرط
            صحيح ص_خ = 0
            حلقة()
                اذا(ص_خ = 4)
                    كسر()
                نهاية_الشرط
                ذاكرة_املأ32(سطح_العميل + ((ر_ز + ص_خ) * عرض_سطح + 16) * 4, لون_هذا, عرض_سطر)
                ص_خ = ص_خ + 1
            نهاية_الحلقة
            ر_ز = ر_ز + 14
            رقم_سطر = رقم_سطر + 1
        نهاية_الحلقة
    نهاية_الشرط

    ذاكرة_اكتب32(مؤشر_السجل + سجل_سطح_ع, عرض_سطح)
    ذاكرة_اكتب32(مؤشر_السجل + سجل_سطح_ا, ارتفاع_سطح)
    ذاكرة_اكتب64(مؤشر_السجل + سجل_سطح_مؤشر, سطح_العميل)
نهاية(جهز_سطح)

دالة(رتب_البلاطات)
    اذا(عدد_نوافذ = 0)
        ارجع()
    نهاية_الشرط
    صحيح م_س = فجوة_خارجية
    صحيح م_ص = شريط_ص + شريط_ا + فجوة_خارجية
    صحيح م_ع = شاشة_ع - فجوة_خارجية * 2
    صحيح م_ا = شاشة_ا - م_ص - فجوة_خارجية
    صحيح اخر_فهرس = عدد_نوافذ - 1
    صحيح فهرس_ت = 0
    حلقة()
        اذا(فهرس_ت = عدد_نوافذ)
            كسر()
        نهاية_الشرط
        صحيح ن_ت = ذاكرة_اقرا32(ترتيب_النوافذ + فهرس_ت * 4)
        مؤشر سج = جدول_النوافذ + ن_ت * حجم_السجل
        صحيح ت_س = م_س
        صحيح ت_ص = م_ص
        صحيح ت_ع = م_ع
        صحيح ت_ا = م_ا
        اذا(فهرس_ت < اخر_فهرس)
            اذا(م_ع > م_ا)
                ت_ع = (م_ع - فجوة_داخلية) / 2
                م_س = م_س + ت_ع + فجوة_داخلية
                م_ع = م_ع - ت_ع - فجوة_داخلية
            والا
                ت_ا = (م_ا - فجوة_داخلية) / 2
                م_ص = م_ص + ت_ا + فجوة_داخلية
                م_ا = م_ا - ت_ا - فجوة_داخلية
            نهاية_الشرط
        نهاية_الشرط
        ذاكرة_اكتب32(سج + سجل_س, ت_س)
        ذاكرة_اكتب32(سج + سجل_ص, ت_ص)
        ذاكرة_اكتب32(سج + سجل_ع, ت_ع)
        ذاكرة_اكتب32(سج + سجل_ا, ت_ا)
        جهز_سطح(سج, ت_ع - سمك_الحد * 2, ت_ا - سمك_الحد * 2)
        فهرس_ت = فهرس_ت + 1
    نهاية_الحلقة
نهاية(رتب_البلاطات)

دالة(فهرس_في_الترتيب, رقم_النافذة)
    صحيح ف = 0
    حلقة()
        اذا(ف = عدد_نوافذ)
            ارجع(-1)
        نهاية_الشرط
        اذا(ذاكرة_اقرا32(ترتيب_النوافذ + ف * 4) = رقم_النافذة)
            ارجع(ف)
        نهاية_الشرط
        ف = ف + 1
    نهاية_الحلقة
    ارجع(-1)
نهاية(فهرس_في_الترتيب)

دالة(انشئ_نافذة)
    اذا(عدد_نوافذ = اقصى_نوافذ)
        ارجع(-1)
    نهاية_الشرط
    صحيح ك = 0
    حلقة()
        اذا(ك = اقصى_نوافذ)
            ارجع(-1)
        نهاية_الشرط
        مؤشر سج = جدول_النوافذ + ك * حجم_السجل
        اذا(ذاكرة_اقرا32(سج) = 0)
            كسر()
        نهاية_الشرط
        ك = ك + 1
    نهاية_الحلقة
    صحيح لون = اختر_لون()
    ذاكرة_اكتب32(سج, 1)
    ذاكرة_اكتب32(سج + سجل_س, 0)
    ذاكرة_اكتب32(سج + سجل_ص, 0)
    ذاكرة_اكتب32(سج + سجل_ع, 0)
    ذاكرة_اكتب32(سج + سجل_ا, 0)
    ذاكرة_اكتب32(سج + سجل_لون, لون)
    ذاكرة_اكتب32(سج + سجل_سطح_ع, 0)
    ذاكرة_اكتب32(سج + سجل_سطح_ا, 0)
    ذاكرة_اكتب64(سج + سجل_سطح_مؤشر, 0)
    ذاكرة_اكتب32(ترتيب_النوافذ + عدد_نوافذ * 4, ك)
    عدد_نوافذ = عدد_نوافذ + 1
    نافذة_نشطة = ك
    يحتاج_ترتيب = 1
    متسخ = 1
    ارجع(ك)
نهاية(انشئ_نافذة)

دالة(اغلق_نافذة, رقم_النافذة)
    مؤشر سج = جدول_النوافذ + رقم_النافذة * حجم_السجل
    مؤشر سطح_العميل = ذاكرة_اقرا64(سج + سجل_سطح_مؤشر)
    اذا(سطح_العميل > 0)
        ذاكرة_حرر(سطح_العميل)
    نهاية_الشرط
    ذاكرة_اكتب32(سج, 0)
    ذاكرة_اكتب32(سج + سجل_سطح_ع, 0)
    ذاكرة_اكتب32(سج + سجل_سطح_ا, 0)
    ذاكرة_اكتب64(سج + سجل_سطح_مؤشر, 0)
    صحيح ف_ر = فهرس_في_الترتيب(رقم_النافذة)
    اذا(ف_ر < 0)
        ارجع()
    نهاية_الشرط
    حلقة()
        صحيح ت_ر = ف_ر + 1
        اذا(ت_ر >= عدد_نوافذ)
            كسر()
        نهاية_الشرط
        ذاكرة_اكتب32(ترتيب_النوافذ + ف_ر * 4, ذاكرة_اقرا32(ترتيب_النوافذ + ت_ر * 4))
        ف_ر = ت_ر
    نهاية_الحلقة
    عدد_نوافذ = عدد_نوافذ - 1
    اذا(نافذة_نشطة = رقم_النافذة)
        نافذة_نشطة = -1
    نهاية_الشرط
    يحتاج_ترتيب = 1
    متسخ = 1
نهاية(اغلق_نافذة)

دالة(بدل_بلاطتين, ن1, ن2)
    صحيح ف_اول = فهرس_في_الترتيب(ن1)
    صحيح ف_ثاني = فهرس_في_الترتيب(ن2)
    اذا(ف_اول < 0)
        ارجع()
    نهاية_الشرط
    اذا(ف_ثاني < 0)
        ارجع()
    نهاية_الشرط
    ذاكرة_اكتب32(ترتيب_النوافذ + ف_اول * 4, ن2)
    ذاكرة_اكتب32(ترتيب_النوافذ + ف_ثاني * 4, ن1)
نهاية(بدل_بلاطتين)

دالة(ابحث_عن_نافذة, س, ص)
    ن_اصابة = -1
    جزء_اصابة = 0
    صحيح فهرس_ب = 0
    حلقة()
        اذا(فهرس_ب = عدد_نوافذ)
            ارجع()
        نهاية_الشرط
        صحيح ن_ب = ذاكرة_اقرا32(ترتيب_النوافذ + فهرس_ب * 4)
        مؤشر سج_ب = جدول_النوافذ + ن_ب * حجم_السجل
        صحيح ب_س = ذاكرة_اقرا32(سج_ب + سجل_س)
        صحيح ب_ص = ذاكرة_اقرا32(سج_ب + سجل_ص)
        صحيح ب_ع = ذاكرة_اقرا32(سج_ب + سجل_ع)
        صحيح ب_ا = ذاكرة_اقرا32(سج_ب + سجل_ا)
        اذا(س >= ب_س)
            اذا(س < ب_س + ب_ع)
                اذا(ص >= ب_ص)
                    اذا(ص < ب_ص + ب_ا)
                        ن_اصابة = ن_ب
                        جزء_اصابة = 3
                        اذا(ن_ب = نافذة_نشطة)
                            صحيح ز_س = ب_س + ب_ع - سمك_الحد - ازاحة_زر
                            صحيح ز_ص = ب_ص + سمك_الحد + هامش_زر
                            اذا(س >= ز_س - 2)
                                اذا(س < ز_س + حجم_زر + 2)
                                    اذا(ص >= ز_ص - 2)
                                        اذا(ص < ز_ص + حجم_زر + 2)
                                            جزء_اصابة = 2
                                        نهاية_الشرط
                                    نهاية_الشرط
                                نهاية_الشرط
                            نهاية_الشرط
                        نهاية_الشرط
                        ارجع()
                    نهاية_الشرط
                نهاية_الشرط
            نهاية_الشرط
        نهاية_الشرط
        فهرس_ب = فهرس_ب + 1
    نهاية_الحلقة
نهاية(ابحث_عن_نافذة)

دالة(عالج_ضغطة, س, ص, اصابة, جزء)
    اذا(س >= زر_س)
        اذا(س < زر_س + زر_ع)
            اذا(ص >= زر_ص)
                اذا(ص < زر_ص + زر_ا)
                    انشئ_نافذة()
                    ارجع()
                نهاية_الشرط
            نهاية_الشرط
        نهاية_الشرط
    نهاية_الشرط
    اذا(اصابة < 0)
        ارجع()
    نهاية_الشرط
    اذا(جزء = 2)
        اغلق_نافذة(اصابة)
        ارجع()
    نهاية_الشرط
    سحب_ن = اصابة
    هدف_تبديل = -1
    نافذة_نشطة = اصابة
    متسخ = 1
نهاية(عالج_ضغطة)

دالة(معالج_الفأرة)
    صحيح ج_س = موضع_س
    صحيح ج_ص = موضع_ص
    اذا(ج_س < 0)
        ارجع()
    نهاية_الشرط
    اذا(ج_ص < 0)
        ارجع()
    نهاية_الشرط
    اذا(ج_س > شاشة_ع - 12)
        ج_س = شاشة_ع - 12
    نهاية_الشرط
    اذا(ج_ص > شاشة_ا - 16)
        ج_ص = شاشة_ا - 16
    نهاية_الشرط
    صحيح س = ج_س
    صحيح ص = ج_ص
    صحيح ضغط = زر_الفأرة
    ابحث_عن_نافذة(س, ص)
    صحيح تغير_تركيز = 0
    اذا(تركيز_بالمؤشر = 1)
        اذا(سحب_ن < 0)
            اذا(ن_اصابة >= 0)
                تغير_تركيز = 1
                اذا(ن_اصابة = نافذة_نشطة)
                    تغير_تركيز = 0
                نهاية_الشرط
            نهاية_الشرط
        نهاية_الشرط
    نهاية_الشرط
    اذا(تغير_تركيز = 1)
        اذا(ن_اصابة = ن_مرشح)
            عداد_تركيز = عداد_تركيز + 1
        والا
            ن_مرشح = ن_اصابة
            عداد_تركيز = 0
        نهاية_الشرط
        اذا(عداد_تركيز >= تاخير_التركيز)
            نافذة_نشطة = ن_اصابة
            متسخ = 1
            ن_مرشح = -1
            عداد_تركيز = 0
        نهاية_الشرط
    والا
        ن_مرشح = -1
        عداد_تركيز = 0
    نهاية_الشرط
    اذا(ضغط = 1)
        اذا(ضغط_سابق = 0)
            عالج_ضغطة(س, ص, ن_اصابة, جزء_اصابة)
        نهاية_الشرط
    نهاية_الشرط
    اذا(سحب_ن >= 0)
        اذا(ضغط = 1)
            صحيح ن_هدف_جديد = ن_اصابة
            اذا(ن_اصابة = سحب_ن)
                ن_هدف_جديد = -1
            نهاية_الشرط
            اذا(ن_هدف_جديد != هدف_تبديل)
                هدف_تبديل = ن_هدف_جديد
                متسخ = 1
            نهاية_الشرط
            اذا(س != قديم_س)
                متسخ = 1
            والا
                اذا(ص != قديم_ص)
                    متسخ = 1
                نهاية_الشرط
            نهاية_الشرط
        والا
            اذا(هدف_تبديل >= 0)
                بدل_بلاطتين(سحب_ن, هدف_تبديل)
                نافذة_نشطة = سحب_ن
                يحتاج_ترتيب = 1
            نهاية_الشرط
            سحب_ن = -1
            هدف_تبديل = -1
            متسخ = 1
        نهاية_الشرط
    نهاية_الشرط
    ضغط_سابق = ضغط
نهاية(معالج_الفأرة)

دالة(ركب_المشهد)
    امسح_الخلفية()
    ارسم_الشريط()
    صحيح فهرس_ر = 0
    حلقة()
        اذا(فهرس_ر = عدد_نوافذ)
            كسر()
        نهاية_الشرط
        صحيح ن_رسم = ذاكرة_اقرا32(ترتيب_النوافذ + فهرس_ر * 4)
        ارسم_نافذة(ن_رسم)
        فهرس_ر = فهرس_ر + 1
    نهاية_الحلقة
    اذا(سحب_ن >= 0)
        مؤشر سج = جدول_النوافذ + سحب_ن * حجم_السجل
        صحيح لون_سحب = ذاكرة_اقرا32(سج + سجل_لون)
        صحيح س_سحب = قديم_س + 14
        صحيح ص_سحب = قديم_ص + 14
        اذا(س_سحب > شاشة_ع - 72)
            س_سحب = شاشة_ع - 72
        نهاية_الشرط
        اذا(ص_سحب > شاشة_ا - 44)
            ص_سحب = شاشة_ا - 44
        نهاية_الشرط
        ارسم_مستطيل_مدور(س_سحب, ص_سحب, 72, 44, لون_سحب, 6)
    نهاية_الشرط
    ذاكرة_انسخ(اطار, مشهد, حجم_الاطار)
    ارسم_المؤشر()
    ذاكرة_انسخ(مؤشر_الأمامية, اطار, حجم_الاطار)
    قديم_س = س
    قديم_ص = ص
    متسخ = 0
نهاية(ركب_المشهد)

دالة(العرض)
    اذا(فشل = 1)
        ارجع()
    نهاية_الشرط
    اذا(جدول_النوافذ = 0)
        جدول_النوافذ = ذاكرة_خصص(اقصى_نوافذ * حجم_السجل)
    نهاية_الشرط
    اذا(ترتيب_النوافذ = 0)
        ترتيب_النوافذ = ذاكرة_خصص(64)
    نهاية_الشرط
    اذا(جدول_النوافذ = 0)
        ارجع()
    نهاية_الشرط
    اذا(ترتيب_النوافذ = 0)
        ارجع()
    نهاية_الشرط
    ذاكرة_املأ32(جدول_النوافذ, 0, اقصى_نوافذ * حجم_السجل / 4)
    زر_س = شاشة_ع - فجوة_خارجية - 12 - زر_ع
    زر_ص = شريط_ص + 4
    انشئ_نافذة()
    انشئ_نافذة()
    انشئ_نافذة()
    رتب_البلاطات()
    يحتاج_ترتيب = 0
    متسخ = 1
نهاية(العرض)
