دالة(امسح_المؤشر)
    سهم_ر = 0
    حلقة()
        اذا(سهم_ر = 16)
            كسر()
        نهاية_الشرط
        سهم_ازاحة = (سهم_قديم_ص + سهم_ر) * ل + سهم_قديم_س * 4
        ذاكرة_انسخ(اطار + سهم_ازاحة, مشهد + سهم_ازاحة, 48)
        سهم_ر = سهم_ر + 1
    نهاية_الحلقة
نهاية(امسح_المؤشر)

دالة(ارسم_المؤشر)
    اذا(سهم_س < 0)
        ارجع()
    نهاية_الشرط
    اذا(سهم_ص < 0)
        ارجع()
    نهاية_الشرط
    اذا(سهم_س > عرض_الشاشة - 16)
        ارجع()
    نهاية_الشرط
    اذا(سهم_ص > ارتفاع_الشاشة - 16)
        ارجع()
    نهاية_الشرط

    املأ_مثلث_قائم_على(اطار, سهم_س + 4, سهم_ص + 2, 9, 0x00FFFFFF)
    املأ_مستطيل_على(اطار, سهم_س + 12, سهم_ص + 11, 2, 4, 0x00FFFFFF)
نهاية(ارسم_المؤشر)

دالة(ادفع_مستطيل)
    سهم_ر = 0
    حلقة()
        اذا(سهم_ر = 16)
            كسر()
        نهاية_الشرط
        سهم_ازاحة = (سهم_م_ص + سهم_ر) * ل + سهم_م_س * 4
        ذاكرة_انسخ(مؤشر_الأمامية + سهم_ازاحة, اطار + سهم_ازاحة, 48)
        سهم_ر = سهم_ر + 1
    نهاية_الحلقة
نهاية(ادفع_مستطيل)

دالة(حدث_المؤشر)
    سهم_س = موضع_س
    سهم_ص = موضع_ص
    اذا(سهم_س < 0)
        سهم_س = 0
    نهاية_الشرط
    اذا(سهم_ص < 0)
        سهم_ص = 0
    نهاية_الشرط
    اذا(سهم_س > عرض_الشاشة - 16)
        سهم_س = عرض_الشاشة - 16
    نهاية_الشرط
    اذا(سهم_ص > ارتفاع_الشاشة - 16)
        سهم_ص = ارتفاع_الشاشة - 16
    نهاية_الشرط
    اذا(سهم_س = سهم_قديم_س)
        اذا(سهم_ص = سهم_قديم_ص)
            ارجع()
        نهاية_الشرط
    نهاية_الشرط
    اذا(سهم_قديم_س >= 0)
        امسح_المؤشر()
        سهم_م_س = سهم_قديم_س
        سهم_م_ص = سهم_قديم_ص
        ادفع_مستطيل()
    نهاية_الشرط
    ارسم_المؤشر()
    سهم_م_س = سهم_س
    سهم_م_ص = سهم_ص
    ادفع_مستطيل()
    سهم_قديم_س = سهم_س
    سهم_قديم_ص = سهم_ص
نهاية(حدث_المؤشر)
