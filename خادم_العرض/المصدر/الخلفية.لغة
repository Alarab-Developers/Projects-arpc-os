تضمين(".\المصدر\لوحة_الرسم_الرقمية\الاشكال_الهندسية.لغة")
تضمين(".\المصدر\تعريفات.لغة")

دالة(حضّر_الخلفية_مرة_واحدة)
    اذا(تم_تحضير_الخلفية = 1)
        ارجع()
    نهاية_الشرط
    اذا(خلفية_محفوظة = 0)
        خلفية_محفوظة = ذاكرة_خصص(حجم_الاطار)
    نهاية_الشرط
    اذا(خلفية_محفوظة = 0)
        ارجع()
    نهاية_الشرط
    صحيح عرض_فعلي = عرض_الشاشة
    صحيح شرائط = 128
    صحيح ارتفاع_شريط = ارتفاع_الشاشة / شرائط
    صحيح شريط = 0
    حلقة()
        اذا(شريط >= شرائط)
            كسر()
        نهاية_الشرط
        صحيح مرحلة = شريط / شرائط_لكل_مرحلة
        اذا(مرحلة >= عدد_المراحل)
            مرحلة = عدد_المراحل - 1
        نهاية_الشرط
        صحيح لون_بداية = لون1
        صحيح لون_نهاية = لون2
        اذا(مرحلة = 1)
            لون_بداية = لون2
            لون_نهاية = لون3
        نهاية_الشرط
        اذا(مرحلة = 2)
            لون_بداية = لون3
            لون_نهاية = لون4
        نهاية_الشرط
        صحيح موقع_داخل_المرحلة = شريط - (مرحلة * شرائط_لكل_مرحلة)
        صحيح نسبة = (موقع_داخل_المرحلة * 255) / (شرائط_لكل_مرحلة - 1)
        اذا(نسبة > 255)
            نسبة = 255
        نهاية_الشرط
        صحيح ب_ح = (لون_بداية >> 16) & 0xFF
        صحيح ب_خ = (لون_بداية >> 8) & 0xFF
        صحيح ب_ز = لون_بداية & 0xFF
        صحيح ن_ح = (لون_نهاية >> 16) & 0xFF
        صحيح ن_خ = (لون_نهاية >> 8) & 0xFF
        صحيح ن_ز = لون_نهاية & 0xFF
        صحيح ح_ح = ب_ح + ((ن_ح - ب_ح) * نسبة) / 255
        صحيح ح_خ = ب_خ + ((ن_خ - ب_خ) * نسبة) / 255
        صحيح ح_ز = ب_ز + ((ن_ز - ب_ز) * نسبة) / 255
        صحيح لون_الشريط_ح = (ح_ح << 16) | (ح_خ << 8) | ح_ز
        ذاكرة_املأ32(خلفية_محفوظة + شريط * ارتفاع_شريط * ل, لون_الشريط_ح, عرض_فعلي * ارتفاع_شريط)
        شريط = شريط + 1
    نهاية_الحلقة
    تم_تحضير_الخلفية = 1
نهاية(حضّر_الخلفية_مرة_واحدة)

دالة(امسح_الخلفية)
    حضّر_الخلفية_مرة_واحدة()
    اذا(خلفية_محفوظة > 0)
        ذاكرة_انسخ(مشهد, خلفية_محفوظة, حجم_الاطار)
    نهاية_الشرط
نهاية(امسح_الخلفية)
