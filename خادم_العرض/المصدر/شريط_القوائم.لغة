        صحيح ر_ا = 8
        صحيح ر_ع = 8
        صحيح ر_لون = لون_خانة_فارغة
        اذا(فهرس_ر < عدد_نوافذ)
            صحيح ن_ح = ذاكرة_اقرا32(ترتيب_النوافذ + فهرس_ر * 4)
            ر_ع = 18
            ر_لون = لون_خانة_خاملة
            اذا(ن_ح = نافذة_نشطة)
                ر_ع = 36
                مؤشر سج = جدول_النوافذ + ن_ح * حجم_السجل
                ر_لون = ذاكرة_اقرا32(سج + سجل_لون)
            نهاية_الشرط
        نهاية_الشرط
        ارسم_مستطيل_مدور(ح_س, ر_ص, ر_ع, ر_ا, ر_لون, 4)
        ح_س = ح_س + ر_ع + 6
        فهرس_ر = فهرس_ر + 1
    نهاية_الحلقة
    ارسم_مستطيل_مدور(زر_س, زر_ص, زر_ع, زر_ا, لون_زر, 4)
    صحيح لون_علامة_حالي = لون_علامة
    اذا(عدد_نوافذ = اقصى_نوافذ)
        لون_علامة_حالي = لون_خانة_خاملة
    نهاية_الشرط
    ارسم_مستطيل_مدور(زر_س + 9, زر_ص + 7, 10, 2, لون_علامة_حالي, 0)
    ارسم_مستطيل_مدور(زر_س + 13, زر_ص + 3, 2, 10, لون_علامة_حالي, 0)
نهاية(ارسم_الشريط)
