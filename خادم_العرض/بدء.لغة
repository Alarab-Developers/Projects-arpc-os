دالة(البدء_المركب)
    العرض() ؛تهيئة الخادم ووحداتة
    حلقة()
        معالج_الفأرة() ؛ تهيئة
        اذا(يحتاج_ترتيب = 1)
            رتب_البلاطات()
            يحتاج_ترتيب = 0
            متسخ = 1
        نهاية_الشرط
        اذا(متسخ = 1)
            ركب_المشهد()
        والا
            حدث_المؤشر()
        نهاية_الشرط
        انتظر(1)
    نهاية_الحلقة
